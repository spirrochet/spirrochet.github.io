---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description: string;
  track: 'plain' | 'technical';
  // Where the track switch goes: this page's twin on the other track, or, when
  // it has none, the section of the other track that its content belongs to.
  counterpart: string;
  type?: 'website' | 'article';
}

const { title, description, track, counterpart, type = 'website' } = Astro.props;
const siteName = 'Christopher James Kites';
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og-default.png', Astro.site);
const deeper = track === 'plain';
const home = deeper ? '/' : '/technical/';
---

<!doctype html>
<html lang="en" data-track={track}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Christopher James Kites: building with AI coding agents, from evidence." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? siteName} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <ClientRouter />
    <script is:inline>
      let dig = '';
      document.addEventListener('astro:before-preparation', (event) => {
        dig = event.sourceElement?.dataset?.dig ?? '';
        document.documentElement.dataset.dig = dig;
      });
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.dataset.dig = dig;
      });
    </script>
  </head>
  <body>
    <div class="strata" aria-hidden="true"></div>
    <header>
      <nav aria-label="Site">
        <a href={home} class="site-name">{siteName}</a>
        {deeper ? (
          <>
            <a href="/#stories">Stories</a>
            <a href="/journey/">Journey</a>
          </>
        ) : (
          <>
            <a href="/technical/#case-studies">Case studies</a>
            <a href="/technical/timeline/">Timeline</a>
            <a href="/technical/how-this-site-is-built/">This site</a>
          </>
        )}
        <a
          href={counterpart}
          class="track-switch"
          data-track-switch
          data-dig={deeper ? 'down' : 'up'}
          title={deeper ? 'The same ground, in technical detail' : 'The same ground, in plain words'}
        >
          {deeper ? 'Dig deeper ↓' : 'Back to the surface ↑'}
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        © 2026 Christopher James Kites. Writing and images: All rights reserved.
        Site code: <a href="https://github.com/spirrochet/spirrochet.github.io/blob/main/LICENSE">MIT licence</a>.
      </p>
      <p>
        {deeper ? 'You are on the surface: the plain-language telling.' : 'You are in the deep end: the technical telling.'}{' '}
        Built with Astro, tested with Playwright, hosted on GitHub Pages.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --font: system-ui, -apple-system, 'Segoe UI', sans-serif;
    --mono: ui-monospace, 'Cascadia Code', 'SF Mono', Menlo, monospace;
  }
  html[data-track='plain'] {
    color-scheme: light dark;
    --text: #2b2620;
    --muted: #6b6157;
    --bg: #fbf8f3;
    --panel: #f3ece1;
    --accent: #a8481f;
    --rule: #e3d8c8;
    --strata: linear-gradient(90deg, #e9c9a5, #d9a77a 40%, #c98b5b 70%, #a8481f);
  }
  @media (prefers-color-scheme: dark) {
    html[data-track='plain'] {
      --text: #ece4d8;
      --muted: #b3a797;
      --bg: #1d1a17;
      --panel: #2a2520;
      --accent: #e8935f;
      --rule: #3e362e;
    }
  }
  html[data-track='technical'] {
    color-scheme: dark;
    --text: #d9e6ee;
    --muted: #8fa6b5;
    --bg: #0d1922;
    --panel: #13232f;
    --accent: #5fcbd8;
    --rule: #233a4a;
    --strata: repeating-linear-gradient(90deg, #1b3444 0 18px, #23465a 18px 36px, #2f5b70 36px 54px, #5fcbd8 54px 56px);
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    line-height: 1.65;
  }
  .strata {
    height: 6px;
    background: var(--strata);
  }
  header, main, footer {
    max-width: 46rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  header nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .site-name {
    font-weight: 650;
    margin-right: auto;
    text-decoration: none;
  }
  a {
    color: var(--accent);
  }
  .track-switch {
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 0.15rem 0.8rem;
    white-space: nowrap;
  }
  .track-switch:hover,
  .track-switch:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }
  html[data-track='technical'] h1,
  html[data-track='technical'] h2,
  html[data-track='technical'] .eyebrow {
    font-family: var(--mono);
    letter-spacing: -0.01em;
  }
  h1 {
    line-height: 1.2;
  }
  .eyebrow {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 0;
  }
  .lede {
    font-size: 1.15rem;
  }
  .panel {
    background: var(--panel);
    border-radius: 0.6rem;
    padding: 0.4rem 1.2rem;
    margin: 1.5rem 0;
  }
  code {
    font-family: var(--mono);
    font-size: 0.92em;
  }
  blockquote {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--rule);
    color: var(--muted);
  }
  ol.timeline {
    list-style: none;
    padding: 0;
    border-left: 2px solid var(--rule);
  }
  ol.timeline > li {
    position: relative;
    padding: 0 0 1.1rem 1.3rem;
  }
  ol.timeline > li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 0.45rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
  }
  ol.timeline time {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
    font-family: var(--mono);
  }
  footer {
    margin-top: 3rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.88rem;
  }

  @keyframes dig-rise-out { to { transform: translateY(-18%); opacity: 0; } }
  @keyframes dig-rise-in { from { transform: translateY(18%); opacity: 0; } }
  @keyframes dig-sink-out { to { transform: translateY(18%); opacity: 0; } }
  @keyframes dig-sink-in { from { transform: translateY(-18%); opacity: 0; } }
  html[data-dig='down']::view-transition-old(root) { animation: 380ms cubic-bezier(0.4, 0, 0.2, 1) both dig-rise-out !important; }
  html[data-dig='down']::view-transition-new(root) { animation: 380ms cubic-bezier(0.4, 0, 0.2, 1) both dig-rise-in !important; }
  html[data-dig='up']::view-transition-old(root) { animation: 380ms cubic-bezier(0.4, 0, 0.2, 1) both dig-sink-out !important; }
  html[data-dig='up']::view-transition-new(root) { animation: 380ms cubic-bezier(0.4, 0, 0.2, 1) both dig-sink-in !important; }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
