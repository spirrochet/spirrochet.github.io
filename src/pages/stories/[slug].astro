---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, counterpart: entry.data.caseStudy ? `/case-studies/${entry.data.caseStudy}/` : '/technical/#case-studies' },
  }));
}

const { entry, counterpart } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description} track="plain" counterpart={counterpart} type="article">
  <article>
    <p class="eyebrow">A story</p>
    <h1>{entry.data.title}</h1>
    <Content />
    <p class="panel">
      Want the details: the evidence, the mechanisms, what it took to learn?{' '}
      <a href={counterpart} data-dig="down">Dig deeper into this one ↓</a>
    </p>
  </article>
</Base>
