{
  "name": "Portfolio (Astro, Node.js 24)",
  // Microsoft's dev container image, built on the official node:24-bookworm image.
  // Node.js 24 matches the workflow; change both together.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "remoteUser": "node",
  "containerEnv": {
    "ASTRO_TELEMETRY_DISABLED": "1"
  },
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": { "label": "Astro dev server", "onAutoForward": "notify" }
  },
  "postCreateCommand": "npm ci && npx playwright install --with-deps chromium",
  "customizations": {
    "vscode": {
      "extensions": ["astro-build.astro-vscode", "ms-playwright.playwright"]
    }
  }
}
